#!/bin/sh
# Sensor daemon enablement for gts7l.
#
# The accelerometer transformation matrix is deliberately left alone: the
# identity matrix that sensorfw ships is correct on this panel, verified by
# auto-rotation working in all orientations on hardware. An earlier version of
# this package rotated it by 90°, which was a guess carried over from a phone
# port.
set -e

case "$1" in
    configure)
        if [ -d /run/systemd/system ]; then
            systemctl enable sensorfwd.service >/dev/null 2>&1 || true
        fi
    ;;
esac

#DEBHELPER#

exit 0
