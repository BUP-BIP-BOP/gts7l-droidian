# Добавить в debian/rules форка ядра, после `%: dh $@`.
#
# init_boot — безусловная зависимость цели сборки в сниппете Droidian, но
# собирается с заголовком версии 2 и без --dtb. Свежий mkbootimg такое не
# принимает и роняет сборку целиком. Устройство не GKI, DEVICE_HAS_INIT_BOOT не
# выставлен, образ всё равно выбрасывается.
#
# Убрать, когда сниппет перестанет собирать init_boot безусловно.

out/KERNEL_OBJ/init_boot-%.img: out/KERNEL_OBJ/initramfs.%
	touch $@
